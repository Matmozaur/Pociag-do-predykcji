# Check out every text file with LF, even with core.autocrlf=true (Git for Windows default):
# the repo is used from WSL, where CRLF breaks shell-run/parsed files (Makefile, YAML, SQL, env).
* text=auto eol=lf

# Env files are sourced by shells/compose in WSL; CRLF would leave a trailing \r on values.
.env* text eol=lf
*.env text eol=lf

*.png binary
*.jpg binary
*.ico binary
