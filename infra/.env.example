# Copy this file to infra/.env and fill in real values.
# docker compose reads this file automatically from the infra/ directory.

# ── PLK Open Data API ─────────────────────────────────────────────────────────
PLK_BASE_URL=https://pdp-api.plk-sa.pl
PLK_API_KEY=replace_with_your_real_api_key

# ── PostgreSQL (main database) ────────────────────────────────────────────────
POSTGRES_PASSWORD=pociag_dev_secret

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_DB_PASSWORD=airflow_dev_secret
# Required, no default. Generate your own with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=airflow_local_dev_secret_key_change_me
# Optional, both default to admin. Applied only when the user is first created: changing the
# password later does not update an existing user, and a new username adds a second admin.
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_PASSWORD=change_me
